{
  "name": "matma/laravel-smoke-fixture",
  "description": "A minimal Laravel 11 application for testing MATMA package installation",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "rzepeda/matma-php": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.50"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../",
      "options": {
        "symlink": true,
        "versions": {"rzepeda/matma-php": "dev-main"}
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MatmaFixture\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
